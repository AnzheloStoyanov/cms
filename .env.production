# Production Environment Configuration for Hostinger Deployment
# Copy this file to .env and update with your actual values

# Server Configuration
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Application URL (Update with your actual domain)
URL=https://yourdomain.com

# Security Keys - GENERATE NEW SECURE VALUES FOR PRODUCTION
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS="CHANGE_ME_1,CHANGE_ME_2,CHANGE_ME_3,CHANGE_ME_4"
API_TOKEN_SALT=CHANGE_ME_API_TOKEN_SALT
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET
TRANSFER_TOKEN_SALT=CHANGE_ME_TRANSFER_TOKEN_SALT
JWT_SECRET=CHANGE_ME_JWT_SECRET
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY

# Database Configuration
# For MySQL (Recommended for Hostinger)
DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=your_database_name
DATABASE_USERNAME=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_SSL=false

# Optional: Database Pool Configuration
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Optional: For PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=your_database_name
# DATABASE_USERNAME=your_database_user
# DATABASE_PASSWORD=your_database_password
# DATABASE_SCHEMA=public
# DATABASE_SSL=false

# Optional: Database Connection String (alternative to individual settings)
# DATABASE_URL=mysql://user:password@localhost:3306/database_name
# DATABASE_URL=postgres://user:password@localhost:5432/database_name

# Admin Panel Configuration
# ADMIN_PATH=/admin
# ADMIN_URL=https://yourdomain.com/admin

# CORS Configuration (if needed for frontend)
# CORS_ORIGIN=https://your-frontend-domain.com

# File Upload Configuration
# MAX_FILE_SIZE=1000000

# Email Configuration (Optional - for production notifications)
# EMAIL_PROVIDER=sendgrid
# EMAIL_SMTP_HOST=smtp.sendgrid.net
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=your_smtp_username
# EMAIL_SMTP_PASSWORD=your_smtp_password
# EMAIL_DEFAULT_FROM=noreply@yourdomain.com
# EMAIL_DEFAULT_REPLY_TO=support@yourdomain.com

# Cloudinary Configuration (Optional - for media hosting)
# CLOUDINARY_NAME=your_cloudinary_name
# CLOUDINARY_KEY=your_cloudinary_key
# CLOUDINARY_SECRET=your_cloudinary_secret

# AWS S3 Configuration (Optional - for media storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_BUCKET=your_bucket_name

# Logging
# LOG_LEVEL=info

# Rate Limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_DURATION=60000
